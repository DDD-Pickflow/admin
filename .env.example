# 서버 API — iOS 앱과 동일한 주소를 쓴다 (/api 포함)
NEXT_PUBLIC_API_BASE_URL=https://pickflow-api.us/api

# 카카오 로그인
# 카카오 개발자 콘솔 > 앱 키 > REST API 키.
# 인가 코드 요청과 토큰 교환에 모두 쓰이며, 브라우저에 노출되어도 되는 값이다.
NEXT_PUBLIC_KAKAO_REST_API_KEY=

# 카카오 개발자 콘솔 > 보안 > Client Secret.
# 사용 중일 때만 필요하다. 서버에서만 쓰이므로 NEXT_PUBLIC_ 접두사를 붙이지 말 것.
KAKAO_CLIENT_SECRET=

# 로그인을 건너뛰고 목 데이터 화면을 바로 보여준다 (팀 공유용). 기본은 꺼짐.
# 실데이터 전환은 src/lib/config.ts 의 USE_MOCK_DATA 로 하며, 그때 이 값은 무시된다.
# NEXT_PUBLIC_DEMO_MODE=true

# 카카오 콘솔에 등록해야 하는 값 (설정용 메모 — 환경변수 아님)
#   플랫폼 > Web > 사이트 도메인
#     http://localhost:3000
#     https://pickflow-admin.vercel.app
#   카카오 로그인 > Redirect URI
#     http://localhost:3000/auth/callback
#     https://pickflow-admin.vercel.app/auth/callback
